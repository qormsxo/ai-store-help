# 이 파일을 .env로 복사해서 사용한다: cp .env.example .env
# 실제 비밀 값(API 키 등)은 .env에만 넣고, .env는 커밋하지 않는다.

# --- PostgreSQL (docker compose의 db 서비스가 사용) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
# 로컬에서 backend를 직접 실행할 때 사용 (Docker에서는 compose가 db 호스트로 덮어쓴다)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# 주소에 slug가 없을 때 여는 매장. /oak-pine-demo/chat 처럼 slug가 있으면 그 매장이다.
DEFAULT_STORE_SLUG=oak-pine-demo

# --- Gemini (AI Agent) ---
# 키가 없어도 서버는 뜨지만 Agent 호출은 503 LLM_NOT_CONFIGURED가 된다. 키는 https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key
# 다른 Gemini 모델로 바꿀 때는 이 값만 바꾼다.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048
# 요청 한 번의 제한 시간(초)
GEMINI_TIMEOUT=60
# mock: 개발용 가짜 답변(Gemini 호출 없음). gemini: 아래 키와 모델로 실제 호출.
LLM_PROVIDER=mock

# --- Frontend ---
FRONTEND_PORT=5173
